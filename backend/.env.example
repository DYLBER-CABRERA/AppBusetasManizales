# ===== BusetasApp · backend (copiar a .env y completar) =====
# Valores de ejemplo FALSOS. El .env real nunca se sube al repositorio.

# --- Supabase (Panel > Project Settings) ---
# Cadena de conexión: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:TU_CLAVE_DE_BD@db.TU_PROYECTO.supabase.co:5432/postgres
SUPABASE_URL=https://AppBusetasManizales.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
# SOLO backend. Nunca en web-admin ni mobile.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- Servidor ---
PUERTO=8000
CORS_ORIGENES=http://localhost:3000

# --- Simulador de GPS y panel de demo ---
MODO_DEMO=true
SIM_VELOCIDAD_KMH=35
SIM_INTERVALO_S=3

# --- Calendario (fechas AAAA-MM-DD separadas por coma) ---
FESTIVOS=2026-11-02,2026-11-16,2026-12-08,2026-12-25

# --- Telegram (opcional: si queda vacío, el bot se desactiva) ---
TELEGRAM_BOT_TOKEN=

# --- Contraseñas de las cuentas demo (usadas por crear_usuarios_demo.py) ---
DEMO_PASSWORD_ADMIN=cambia_esto_1
DEMO_PASSWORD_MOVILIDAD=cambia_esto_2
DEMO_PASSWORD_JEFE=cambia_esto_3
DEMO_PASSWORD_PASAJERO=cambia_esto_4
