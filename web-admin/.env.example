# Valores falsos: copia este archivo a .env.local y completa los reales. NUNCA subas .env.local.
# Solo claves públicas de Supabase (Auth). La clave service_role NO va aquí.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-anon-falsa
# API del backend (prefijo /api/v1 incluido)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Teselas de OpenStreetMap (se puede cambiar sin tocar el código)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# WebSocket del backend (lo usa el Panel de demo, W2)
NEXT_PUBLIC_WS_URL=ws://localhost:8000
